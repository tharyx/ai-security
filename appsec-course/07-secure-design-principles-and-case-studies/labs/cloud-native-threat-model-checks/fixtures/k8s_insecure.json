[
  {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "shop", "labels": {"pod-security.kubernetes.io/enforce": "privileged"}}},
  {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "orders-api", "namespace": "shop"},
   "spec": {"template": {"spec": {
     "hostNetwork": true,
     "volumes": [{"name": "docker", "hostPath": {"path": "/var/run/docker.sock"}}],
     "containers": [{"name": "api", "image": "registry.example/shop/orders-api:latest",
                     "securityContext": {"privileged": true},
                     "env": [{"name": "DB_PASSWORD", "value": "FAKE-not-a-real-password"}]}]}}}},
  {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "ClusterRole", "metadata": {"name": "ci-deployer"},
   "rules": [{"apiGroups": ["*"], "resources": ["*"], "verbs": ["*"]}]},
  {"apiVersion": "rbac.authorization.k8s.io/v1", "kind": "ClusterRoleBinding", "metadata": {"name": "debug-anon"},
   "roleRef": {"kind": "ClusterRole", "name": "view"},
   "subjects": [{"kind": "Group", "name": "system:unauthenticated"}]}
]
