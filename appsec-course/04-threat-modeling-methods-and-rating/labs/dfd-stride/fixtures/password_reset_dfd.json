{
  "_comment": "FICTIONAL password reset feature, level-1 DFD.",
  "name": "Password reset",
  "zones": ["internet", "third-party", "app", "data"],
  "elements": [
    {"id": "user", "type": "external", "zone": "internet", "label": "User (or attacker)"},
    {"id": "mail", "type": "external", "zone": "third-party", "label": "Email provider"},
    {"id": "reset_app", "type": "process", "zone": "app", "label": "Reset service"},
    {"id": "users_db", "type": "datastore", "zone": "data", "label": "Users DB"},
    {"id": "token_store", "type": "datastore", "zone": "app", "label": "Reset token cache"},
    {"id": "audit_log", "type": "datastore", "zone": "data", "label": "Audit log", "holds_logs": true}
  ],
  "flows": [
    {"id": "F1", "src": "user", "dst": "reset_app", "label": "POST /forgot (email)"},
    {"id": "F2", "src": "reset_app", "dst": "token_store", "label": "save token hash + expiry"},
    {"id": "F3", "src": "reset_app", "dst": "mail", "label": "send reset link"},
    {"id": "F4", "src": "user", "dst": "reset_app", "label": "POST /reset (token, new password)"},
    {"id": "F5", "src": "token_store", "dst": "reset_app", "label": "look up token"},
    {"id": "F6", "src": "reset_app", "dst": "users_db", "label": "update password hash"},
    {"id": "F7", "src": "reset_app", "dst": "audit_log", "label": "reset events"},
    {"id": "F8", "src": "reset_app", "dst": "user", "label": "generic response"}
  ]
}
