{
 "version": "2.1.0",
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "semgrep-like",
     "rules": [
      {
       "id": "python.flask.debug-enabled",
       "shortDescription": {
        "text": "Flask debug mode enabled"
       },
       "properties": {
        "security-severity": "5.0"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "python.flask.debug-enabled",
     "level": "warning",
     "message": {
      "text": "Flask debug mode enabled"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "orders/app.py"
        },
        "region": {
         "startLine": 88
        }
       }
      }
     ]
    }
   ]
  }
 ]
}