{
 "version": "2.1.0",
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "semgrep-like",
     "rules": [
      {
       "id": "python.flask.debug-enabled",
       "shortDescription": {
        "text": "Flask debug mode enabled"
       },
       "properties": {
        "security-severity": "5.0"
       }
      },
      {
       "id": "python.jwt.verify-disabled",
       "shortDescription": {
        "text": "JWT decoded without signature verification"
       },
       "properties": {
        "security-severity": "8.2"
       }
      },
      {
       "id": "python.logging.secret-in-log",
       "shortDescription": {
        "text": "Possible secret written to a log"
       }
      },
      {
       "id": "python.sqlalchemy.sqli.string-concat",
       "shortDescription": {
        "text": "SQL built with string concatenation"
       },
       "properties": {
        "security-severity": "9.1"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "python.sqlalchemy.sqli.string-concat",
     "level": "error",
     "message": {
      "text": "SQL built with string concatenation"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "orders/repo.py"
        },
        "region": {
         "startLine": 41
        }
       }
      }
     ]
    },
    {
     "ruleId": "python.jwt.verify-disabled",
     "level": "error",
     "message": {
      "text": "JWT decoded without signature verification"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "orders/auth.py"
        },
        "region": {
         "startLine": 17
        }
       }
      }
     ]
    },
    {
     "ruleId": "python.flask.debug-enabled",
     "level": "warning",
     "message": {
      "text": "Flask debug mode enabled"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "orders/app.py"
        },
        "region": {
         "startLine": 88
        }
       }
      }
     ]
    },
    {
     "ruleId": "python.logging.secret-in-log",
     "level": "note",
     "message": {
      "text": "Possible secret written to a log"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "orders/payments.py"
        },
        "region": {
         "startLine": 12
        }
       }
      }
     ]
    }
   ]
  }
 ]
}