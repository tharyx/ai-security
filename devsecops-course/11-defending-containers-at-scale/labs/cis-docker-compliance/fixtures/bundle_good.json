{
  "host": {
    "docker_partition_separate": true,
    "auditd_watches": ["/usr/bin/dockerd", "/var/lib/docker", "/etc/docker", "/run/docker.sock"],
    "docker_group_members": ["alice", "svc-ci"],
    "approved_docker_users": ["alice", "svc-ci"]
  },
  "files": {
    "/usr/lib/systemd/system/docker.service": {"owner": "root:root", "mode": "0644"},
    "/var/run/docker.sock": {"owner": "root:docker", "mode": "0660"},
    "/etc/docker/daemon.json": {"owner": "root:root", "mode": "0644"}
  },
  "daemon": {
    "hosts": ["fd://", "tcp://10.0.0.5:2376"],
    "tlsverify": true, "tlscacert": "/etc/docker/ca.pem", "tlscert": "/etc/docker/server.pem", "tlskey": "/etc/docker/server-key.pem",
    "icc": false, "userns-remap": "default", "log-driver": "fluentd", "live-restore": true,
    "userland-proxy": false, "no-new-privileges": true
  },
  "containers": [
    {"Name": "/web", "Config": {"User": "10001", "Healthcheck": {"Test": ["CMD", "true"]}},
     "HostConfig": {"Privileged": false, "CapAdd": null, "Memory": 268435456, "CpuShares": 512, "PidsLimit": 200,
                    "ReadonlyRootfs": true, "SecurityOpt": ["no-new-privileges", "apparmor=docker-default"],
                    "PidMode": "", "NetworkMode": "bridge", "Binds": null,
                    "RestartPolicy": {"Name": "on-failure", "MaximumRetryCount": 5}, "Devices": []}}
  ]
}
