{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "version": "1.56.0",
          "rules": [
            {"id": "js-sql-concat", "shortDescription": {"text": "SQL built by string concatenation"},
             "properties": {"tags": ["CWE-89", "security"], "security-severity": "8.1"}},
            {"id": "js-weak-random", "shortDescription": {"text": "Insecure random for a security value"},
             "properties": {"tags": ["CWE-338"], "security-severity": "5.3"}},
            {"id": "js-console-log", "shortDescription": {"text": "console.log left in code"},
             "properties": {"tags": ["style"]}}
          ]
        }
      },
      "results": [
        {"ruleId": "js-sql-concat", "level": "error",
         "message": {"text": "User input is concatenated into a SQL string"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/orders.js"}, "region": {"startLine": 42}}}]},
        {"ruleId": "js-sql-concat", "level": "error",
         "message": {"text": "User input is concatenated into a SQL string"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/orders.js"}, "region": {"startLine": 44}}}]},
        {"ruleId": "js-weak-random", "level": "warning",
         "message": {"text": "Math.random() used to build a reset code"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/reset.js"}, "region": {"startLine": 13}}}]},
        {"ruleId": "js-console-log", "level": "note",
         "message": {"text": "console.log in production code"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app.js"}, "region": {"startLine": 5}}}]}
      ]
    }
  ]
}
